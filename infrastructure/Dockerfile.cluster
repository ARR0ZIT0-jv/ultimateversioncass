FROM ubuntu:24.04

ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    g++ \
    make \
    cmake \
    libopenmpi-dev \
    openmpi-bin \
    openssh-server \
    openssh-client \
    python3 \
    python3-pip \
    net-tools \
    iputils-ping \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Configuración del demonio SSH
RUN mkdir -p /var/run/sshd /root/.ssh && \
    chmod 0755 /var/run/sshd && \
    echo "PermitRootLogin yes" >> /etc/ssh/sshd_config && \
    echo "StrictHostKeyChecking no" >> /etc/ssh/ssh_config && \
    echo "UserKnownHostsFile /dev/null" >> /etc/ssh/ssh_config

# Generar par de claves ed25519 en tiempo de build (NO se versiona la clave privada)
# Los tres contenedores usan la misma imagen => misma clave => SSH sin contraseña entre nodos.
RUN ssh-keygen -t ed25519 -N "" -f /root/.ssh/id_ed25519 && \
    cat /root/.ssh/id_ed25519.pub >> /root/.ssh/authorized_keys && \
    chmod 600 /root/.ssh/id_ed25519 /root/.ssh/authorized_keys

COPY infrastructure/ssh/config /root/.ssh/config
RUN chmod 600 /root/.ssh/config

# Directorio de trabajo montado
WORKDIR /workspace

# Script de entrada para orquestación de arranque
COPY infrastructure/entrypoint.sh /usr/local/bin/entrypoint.sh
RUN chmod +x /usr/local/bin/entrypoint.sh

EXPOSE 22 8000

ENTRYPOINT ["/usr/local/bin/entrypoint.sh"]
